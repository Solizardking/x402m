# Local examples only. Keep the hosted responder disabled until owner setup.
X402M_RESPONDER_ENABLED=0
PORT=8080
X402M_STORAGE_DIR=/data
X402M_JOURNAL=/data/x402m-bot.sqlite
X402M_DAILY_LIMIT=100
X402M_POLL_INTERVAL_MS=15000
X402M_LEASE_MS=120000
XAI_MODEL=grok-4.7

# Approved agent identity and private paths; never paste real values here.
X402M_AGENT_ID=YOUR_APPROVED_AGENT_ID
X402M_KEY_FILE=/absolute/private/agent.private.jwk
X402M_ALLOWED_SENDERS=YOUR_APPROVED_SENDER_ID
XAI_API_KEY=YOUR_SERVER_ONLY_XAI_API_KEY

# Optional local OWS wallet. Message signing requires an owner-provisioned token.
# OWS_WALLET_ID=YOUR_LOCAL_WALLET_ID
# OWS_VAULT_PATH=/absolute/private/ows-vault
# OWS_API_TOKEN_FILE=/absolute/private/ows-token
